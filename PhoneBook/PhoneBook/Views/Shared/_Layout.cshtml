@using System.Security.Claims
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="~/images/logoSagsnoWord.ico" />
    <title>SAGS::PHONEBOOK</title>

    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <!-- Bootstrap CSS local -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />

    <!-- Kendo CSS local -->
    <link href="~/lib/kendo/css/web/default-turquoise.css" rel="stylesheet" type="text/css" />

    <!-- Font Awesome từ CDN (tránh lỗi MIME local) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- jQuery local -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- JSZip từ CDN (file local bị 404) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <!-- Kendo JS local -->
    <script src="~/lib/kendo/js/kendo.all.min.js"></script>
    <script src="~/lib/kendo/js/kendo.aspnetmvc.min.js"></script>

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Be Vietnam Pro', 'Roboto', sans-serif;
            background: #f5f7fa;
            font-size: 13px;
        }

        /* ── Navbar ── */
        .navbar-custom {
            background: linear-gradient(90deg, #0079bf, #5067c5);
            padding: 0.3rem 1rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            min-height: 64px;
        }

        .navbar-brand {
            display: flex;
            align-items: flex-end;
            gap: 32px;
            padding-top: 2px;
        }

        .navbar-logo {
            height: 50px;
            width: auto;
            max-width: 140px;
            transform: scale(1.15);
            transform-origin: left center;
        }

        .navbar-brand-text {
            color: #fff;
            font-weight: 700;
            font-size: 24px;
            line-height: 1;
        }

        .navbar-toggler {
            border: none;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.8)' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        .user-info {
            color: #fff;
            text-align: right;
            line-height: 1.4;
        }

        .user-name {
            font-weight: 600;
            font-size: 13px;
        }

        .user-position {
            font-size: 11px;
            opacity: 0.85;
        }

        .btn-logout {
            background: rgba(255,255,255,0.95);
            color: #0079bf;
            border: none;
            padding: 7px 18px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.25s;
            cursor: pointer;
            white-space: nowrap;
        }

            .btn-logout:hover {
                background: #fff;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            }

        /* ── Toast ── */
        .toast-notify {
            position: fixed;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #202124;
            color: #fff;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            z-index: 9999;
            transition: transform .3s ease;
            pointer-events: none;
            white-space: nowrap;
        }

            .toast-notify.show {
                transform: translateX(-50%) translateY(0);
            }

            .toast-notify.success {
                background: #137333;
            }

            .toast-notify.error {
                background: #d93025;
            }

        @@media (max-width: 992px) {
            .user-info {
                text-align: left;
                margin-bottom: 8px;
            }

            .navbar-brand-text {
                font-size: 18px;
            }

            .btn-logout {
                font-size: 12px;
                padding: 6px 12px;
            }
        }

        @@media (max-width: 576px) {
            .user-position {
                display: none;
            }

            .navbar-logo {
                height: 36px;
            }

            .user-name {
                font-size: 12px;
            }

            .navbar-brand-text {
                font-size: 15px;
            }
        }
    </style>
</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        var fullName = User.FindFirst("FullName")?.Value;
        var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        <nav class="navbar navbar-custom navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <img src="~/images/sagsLogo.png" alt="Logo" class="navbar-logo"
                         onerror="this.style.display='none';document.getElementById('navFallback').style.display='flex';" />
                    <div id="navFallback" style="display:none;align-items:center;">
                        <h1 class="navbar-brand-text">PhoneBook</h1>
                    </div>
                    <h1 class="navbar-brand-text">PHONEBOOK</h1>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="d-flex align-items-center ms-auto gap-3 flex-wrap">
                        <div class="user-info">
                            <div class="user-name">@fullName &nbsp;|&nbsp; @userId</div>
                            <div class="user-position">@User.FindFirst("PositionName")?.Value</div>
                        </div>
                        <button class="btn-logout" onclick="handleLogout(this)">
                            <i class="fas fa-sign-out-alt me-1"></i>Đăng xuất
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    }

    @RenderBody()

    <div class="toast-notify" id="toast"></div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script>
        function showToast(msg, type) {
            var t = document.getElementById('toast');
            t.textContent = msg;
            t.className = 'toast-notify' + (type ? ' ' + type : '');
            t.classList.add('show');
            setTimeout(function () { t.classList.remove('show'); }, 3000);
        }
    </script>

    <script>
        (function () {
            history.pushState(null, '', location.href);
            window.addEventListener('popstate', function () {
                history.pushState(null, '', location.href);
            });
        })();
    </script>

    @if (User?.Identity?.IsAuthenticated == true)
    {
        <script>
            (function () {
                'use strict';
                window.addEventListener('pageshow', function (e) {
                    if (e.persisted || (window.performance && window.performance.navigation.type === 2)) {
                        window.location.reload(true);
                    }
                });

                var lastCheck        = Date.now();
                var SESSION_INTERVAL = 5 * 60 * 1000;
                var formTouched      = false;

                document.addEventListener('input', function (e) {
                    if (e.target.closest && e.target.closest('form')) formTouched = true;
                }, true);

                function checkSession() {
                    if (Date.now() - lastCheck < SESSION_INTERVAL) return;
                    lastCheck = Date.now();
                    fetch('/Account/CheckSession', { method: 'GET', credentials: 'include', cache: 'no-store' })
                        .then(function (r) {
                            if (r.status === 401 || r.status === 403) {
                                window.location.href = '/Account/Login?error=session_expired';
                            }
                        }).catch(function () {});
                }
                setInterval(checkSession, SESSION_INTERVAL);
            })();
        </script>
    }

    <script>
        function handleLogout(button) {
            if (!button || button.disabled) return;
            var orig = (button.textContent || button.innerText).trim();
            button.dataset.originalText = orig;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang đăng xuất…';
            button.disabled  = true;

            fetch('/Account/Logout', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                credentials: 'include', cache: 'no-store'
            })
            .then(function (r) {
                if (r.ok) {
                    document.cookie.split(';').forEach(function (c) {
                        var base = c.replace(/^ +/, '').replace(/=.*/, '');
                        document.cookie = base + '=;expires=' + new Date(0).toUTCString() + ';path=/';
                    });
                    window.location.replace('/Account/Login?_=' + Date.now());
                } else {
                    button.innerHTML = '<i class="fas fa-sign-out-alt me-1"></i>' + orig;
                    button.disabled  = false;
                    showToast('Đăng xuất thất bại. Vui lòng thử lại.', 'error');
                }
            })
            .catch(function () {
                button.innerHTML = '<i class="fas fa-sign-out-alt me-1"></i>' + orig;
                button.disabled  = false;
                showToast('Lỗi kết nối.', 'error');
            });
        }
    </script>

    <script>
        $(document).ready(function () {
            $(document).ajaxError(function (ev, jqXHR) {
                if (jqXHR.status === 401) window.location.href = '/Account/Login?error=session_expired';
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
